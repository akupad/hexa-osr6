<Window x:Class="Hexa.Views.CompactOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Hexa.Controls"
        Title="Hexa Overlay"
        Width="300" Height="54"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 小窗专用的排版小样式：标签弱、数值强。
             每个数值都留了固定最小宽度，个位数/百位数切换时整窗不会左右跳。 -->
        <Style x:Key="OvLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OvValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OvSep" TargetType="TextBlock">
            <Setter Property="Text" Value="│"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0"/>
        </Style>

        <!-- 关闭 / 急停 用的小按钮：Tag=close 悬停变红；Tag=armed 是「连点两次」的确认态 -->
        <Style x:Key="OvAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <!-- App.xaml 的隐式 TextBlock 样式会把按钮文字钉成浅色，
                                         这里把文字颜色绑回按钮自己的 Foreground，确认态才变得了色。 -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="close"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="armed">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Danger}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnDangerInk}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 整块都能拖（两个按钮除外）；底板刷子由 code-behind 按不透明度和当前状态动态生成 -->
    <Border x:Name="RootBorder"
            Background="#F20E1116"
            BorderBrush="{StaticResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="10"
            Cursor="SizeAll"
            MouseLeftButtonDown="RootBorder_MouseDown"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid x:Name="ContentGrid" Margin="11,8,7,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一行（最重要）：连接状态 + 现在在跑什么 -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                <Border x:Name="CellConn" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ConnText" Text="未连接" MinWidth="46"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Faint}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CellMode" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SepMode" Style="{StaticResource OvSep}"/>
                        <TextBlock x:Name="ModeText" Text="待机" MinWidth="68"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Faint}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 第二行：数值。BPM / 强度 在前，速度是次要信息（用淡色，不抢视线） -->
            <StackPanel x:Name="ValueRow" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,2,10,0">
                <Border x:Name="CellBpm" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SepBpm" Style="{StaticResource OvSep}"/>
                        <TextBlock Text="BPM" Style="{StaticResource OvLabel}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="BpmText" Text="--" Style="{StaticResource OvValue}"
                                   MinWidth="22" Foreground="{StaticResource Warning}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CellIntensity" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SepIntensity" Style="{StaticResource OvSep}"/>
                        <TextBlock Text="强度" Style="{StaticResource OvLabel}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="IntensText" Text="100%" Style="{StaticResource OvValue}"
                                   MinWidth="30" Foreground="{StaticResource Success}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CellSpeed" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SepSpeed" Style="{StaticResource OvSep}"/>
                        <TextBlock Text="速度" Style="{StaticResource OvLabel}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="SpeedText" Text="1.0×" Style="{StaticResource OvValue}"
                                   MinWidth="32" Foreground="{StaticResource Faint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 第三行：「为什么不动」。只在真有问题时出现，一句话说清原因 + 怎么办 -->
            <TextBlock x:Name="WhyText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="" FontSize="10" Foreground="{StaticResource Warning}"
                       TextWrapping="Wrap" MaxWidth="234" Margin="0,4,0,0"
                       Visibility="Collapsed"/>

            <!-- 第四行：快捷调节（点右侧 ▾ 展开）。四根条子 + 五个预设，改了立刻生效 -->
            <StackPanel x:Name="PanelRow" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0,8,0,0" Visibility="Collapsed">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="行程" Style="{StaticResource OvLabel}"/>
                    <controls:RangeSlider x:Name="PanelStrokeRange" Grid.Column="1" Width="190"
                                          Minimum="0" Maximum="100" SmallChange="1"
                                          VerticalAlignment="Center"
                                          ToolTip="左边＝最高（抬到这儿就停），右边＝最深（插到这儿就停）。怕顶出去被压就把左边那个往右拉"/>
                    <TextBlock x:Name="PanelStrokeText" Grid.Column="2" Text="20→70"
                               Style="{StaticResource OvValue}" MinWidth="58" Margin="8,0,0,0"
                               Foreground="{StaticResource Muted}"/>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="扭转" Style="{StaticResource OvLabel}"/>
                    <controls:RangeSlider x:Name="PanelRotateRange" Grid.Column="1" Width="190"
                                          Minimum="0" Maximum="100" SmallChange="1"
                                          VerticalAlignment="Center"
                                          ToolTip="扭转轴 R0 摆动的两头。幅度由强度决定，这里只定「摆到哪儿为止」"/>
                    <TextBlock x:Name="PanelRotateText" Grid.Column="2" Text="6→80"
                               Style="{StaticResource OvValue}" MinWidth="58" Margin="8,0,0,0"
                               Foreground="{StaticResource Muted}"/>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="强度" Style="{StaticResource OvLabel}"/>
                    <Slider x:Name="PanelIntensitySlider" Grid.Column="1" Width="190"
                            Minimum="0.1" Maximum="2.0" SmallChange="0.05" LargeChange="0.2"
                            VerticalAlignment="Center"
                            ToolTip="抽插幅度。100% 是标准刻度，往下更温柔，往上更狠（舒适档另有上限）"/>
                    <TextBlock x:Name="PanelIntensityText" Grid.Column="2" Text="100%"
                               Style="{StaticResource OvValue}" MinWidth="58" Margin="8,0,0,0"
                               Foreground="{StaticResource Success}"/>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="速度" Style="{StaticResource OvLabel}"/>
                    <Slider x:Name="PanelSpeedSlider" Grid.Column="1" Width="190"
                            Minimum="0.1" Maximum="3.0" SmallChange="0.05" LargeChange="0.2"
                            VerticalAlignment="Center"
                            ToolTip="自动动作的快慢。跟游戏走时这个不影响游戏发来的节奏"/>
                    <TextBlock x:Name="PanelSpeedText" Grid.Column="2" Text="1.0×"
                               Style="{StaticResource OvValue}" MinWidth="58" Margin="8,0,0,0"
                               Foreground="{StaticResource Muted}"/>
                </Grid>

                <!-- 五个快速预设（和游玩页那五个同一套参数）+ 点击穿透 -->
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="轻柔" Tag="gentle" Width="44" Margin="0,0,4,4"
                            Style="{StaticResource OvAction}" Click="PresetBtn_Click"/>
                    <Button Content="日常" Tag="daily" Width="44" Margin="0,0,4,4"
                            Style="{StaticResource OvAction}" Click="PresetBtn_Click"/>
                    <Button Content="疯狂" Tag="crazy" Width="44" Margin="0,0,4,4"
                            Style="{StaticResource OvAction}" Click="PresetBtn_Click"/>
                    <Button Content="挑逗" Tag="tease" Width="44" Margin="0,0,4,4"
                            Style="{StaticResource OvAction}" Click="PresetBtn_Click"/>
                    <Button Content="心跳" Tag="heartbeat" Width="44" Margin="0,0,4,4"
                            Style="{StaticResource OvAction}" Click="PresetBtn_Click"/>
                    <Button x:Name="ClickThroughBtn" Content="穿透" Width="44" Margin="0,0,0,4"
                            Style="{StaticResource OvAction}" Click="ClickThroughBtn_Click"
                            ToolTip="勾了以后小窗完全不接鼠标：点哪儿都落到下面的游戏上。要恢复：右键任务栏托盘里的 Hexa 图标 → 取消「悬浮窗点击穿透」"/>
                </WrapPanel>
            </StackPanel>

            <!-- 右侧：急停 / 关闭。急停要点两次才真的执行，误触不会让设备停 -->
            <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                        Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 展开/收起快捷调节：小窗平时只报状态，要动手调就展开 -->
                <Button x:Name="PanelBtn" Content="▾" Tag="panel" Width="22" FontSize="10" Margin="0,0,6,0"
                        Style="{StaticResource OvAction}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTipService.InitialShowDelay="400"
                        ToolTip="展开快捷调节：行程、扭转、强度、速度和五个快速预设。所有改动立刻生效，拖行程条时机器会跟着走"
                        Click="PanelBtn_Click"/>
                <!-- 暂停/继续：就地停住不动，点一下接着走（不打乱节奏、不回中） -->
                <Button x:Name="PauseBtn" Content="⏸" Tag="pause" Width="26" FontSize="11" Margin="0,0,6,0"
                        Style="{StaticResource OvAction}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTipService.InitialShowDelay="400"
                        Click="PauseBtn_Click"/>
                <Button x:Name="StopBtn" Content="急停" Tag="stop" Width="66" Margin="0,0,6,0"
                        Style="{StaticResource OvAction}"
                        ToolTipService.ShowOnDisabled="True"
                        Click="StopBtn_Click"/>
                <Button x:Name="CloseBtn" Content="✕" Tag="close" Width="26" FontSize="12"
                        Style="{StaticResource OvAction}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTipService.InitialShowDelay="600"
                        ToolTip="只把小窗收起来，不影响设备运行。想找回来：右键任务栏托盘里的 Hexa 图标勾选「悬浮窗」，或到「设置」页点「显示悬浮窗」"
                        Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

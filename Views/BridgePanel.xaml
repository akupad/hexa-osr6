<UserControl x:Class="Hexa.Views.BridgePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 为什么抽成控件而不是复制一份：测试台和游玩页要的是同一张「④ 游戏桥」。
         复制两份的代价是两套 x:Name 撞名、两套事件处理器各自漂移，连「端口提示该写什么」都要改两处；
         抽成 UserControl 后只有一份 XAML + 一份逻辑，测试台不再有它，游玩页直接引用 <views:BridgePanel/>。
         控件自己带一套本地样式：FieldLabel / Hint / WrapText 原来定义在 TestLabPage.xaml 的 Page.Resources 里，
         搬到控件后 StaticResource 在控件里找不到（XAML 解析会直接抛），所以这里各留一份等价定义。 -->
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- CheckBox 的模板量孩子时给的是「无限宽」，光写 TextWrapping 不会折行、文字会被卡片边缘切掉，
             所以必须显式给一个上限（与测试台原来那份一致）。 -->
        <Style x:Key="WrapText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>
    </UserControl.Resources>

    <!-- 根内容 = 原来测试台里那张卡的整块（x:Name 一个没改） -->
<Border x:Name="BridgeCard" Style="{StaticResource Card}">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="🌉 游戏桥" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="给「自己会发动作指令的游戏」用：Hexa 在本机开一个服务（游戏里通常叫 Intiface / Buttplug），游戏连上这个端口就能直接指挥设备 —— 动作由游戏决定，Hexa 不编动作。不玩这类游戏就一直关着，不会有任何影响。"
                           Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <Button x:Name="BridgeToggleBtn" Grid.Column="1"
                    Content="开启游戏桥" Style="{StaticResource BtnSecondary}"
                    Width="130" Height="32" VerticalAlignment="Center" Click="BridgeToggle_Click"/>
        </Grid>

        <!-- 状态放在最上面：未开启 / 启动失败 / 等游戏连上来，一眼分得清 -->
        <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="10,8"
                BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BridgeStatusBar" Grid.Column="0" Background="{StaticResource Muted}" CornerRadius="2"/>
                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <TextBlock x:Name="BridgeStatusText" Text="游戏桥未开启" FontSize="11"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BridgeUrlText" Text="开启后，游戏里填：ws://127.0.0.1:12345"
                               Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="BridgeLastCmdText" Text="最近指令：—"
                               Style="{StaticResource Hint}" Foreground="{StaticResource Faint}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="监听端口" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="BridgePortBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                     ToolTip="游戏连的就是这个端口（ws://127.0.0.1:这个数字）。改完按回车生效，范围 1024-65535。"
                     KeyDown="BridgePortBox_KeyDown"/>
        </Grid>
        <!-- 端口提示：常显，不再需要悬停才知道范围与默认值（用户要求「信息一直显示」） -->
        <TextBlock x:Name="BridgePortHint" Text="" Style="{StaticResource Hint}" Margin="92,0,0,8"
                   ToolTip="游戏连的就是这个端口：ws://127.0.0.1:这个数字。改完按回车生效，范围 1024-65535。"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="呈现模式" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="BridgeModeCombo" Grid.Column="1" SelectionChanged="BridgeSetting_Changed"
                      ToolTip="单桥：一台设备干完所有事。双桥：两台设备分开干（一台负责进退、一台负责旋转），适合装了两台的用户。">
                <ComboBoxItem Content="单桥 · 一台设备全包（进退 + 旋转）" Tag="single"/>
                <ComboBoxItem Content="单桥 · 六轴直驱（游戏能直接点名 L0/L1/L2/R0/R1/R2，推荐）" Tag="six"/>
                <ComboBoxItem Content="双桥 · 两台设备分开做（一台进退、一台旋转）" Tag="dual"/>
            </ComboBox>
        </Grid>

        <!-- ── 动作整形：进阶参数，收起来别一次摊一屏 ────────── -->
        <!-- 原始 TCode：VAM 的 ToySerialController 这类插件直接发 "L09999"/"DSTOP" 文本，
             不走 Intiface 协议，所以单列一个开关（以前只能手改 settings.json）。 -->
        <CheckBox x:Name="BridgeRawTcodeCheck" FontSize="12" Margin="0,0,0,4"
                  ToolTip="给 VAM 的 ToySerialController、以及其它直接发 TCode 文本的软件用。打开后 Hexa 在本机 UDP 端口接收 L09999 / R05000I200 / DSTOP 这类原始指令。默认关：关着时那个端口只接受带口令的 Hexa 遥测帧。">
            <TextBlock Style="{StaticResource WrapText}"
                       Text="接收原始 TCode（VAM · ToySerialController 直连）"/>
        </CheckBox>
        <TextBlock x:Name="BridgeRawTcodeHint" Style="{StaticResource Hint}" Margin="20,0,0,10" Text=""/>

        <Border Height="1" Background="{StaticResource Border}" Margin="0,2,0,10"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BridgeShapeToggle" Content="▸ 动作整形（进阶）"
                    Height="28" FontSize="11" Padding="10,0" HorizontalAlignment="Left"
                    Style="{StaticResource BtnGhost}" Click="BridgeShapeToggle_Click"
                    ToolTip="把游戏发来的指令熨平、补上其它轴、限制在舒适档之内（默认已经是推荐值，一般不用动）。三个都关 = 完全按游戏原样透传"/>
            <TextBlock x:Name="BridgeShapeSummary" Grid.Column="1" Text="" Style="{StaticResource Hint}"
                       Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                       TextAlignment="Right" Margin="8,0,0,0"/>
        </Grid>
        <StackPanel x:Name="BridgeShapePanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="游戏发指令又快又碎（每 20-50 毫秒一条）、常常只驱动一根轴、强度还带噪声；照原样转发出来就是「抖 + 平」。下面三项把它熨平、补上其它轴，并限制在舒适档之内。"
                       Style="{StaticResource Hint}" Margin="0,0,0,8"/>
            <CheckBox x:Name="BridgeSmoothCheck" FontSize="12" Margin="0,0,0,4"
                      ToolTip="代价是少量延迟：平滑时间越长越柔、越滞后">
                <TextBlock Style="{StaticResource WrapText}"
                           Text="指令平滑（去抖）：按固定节拍把指令流追过去，而不是一条一条原样转发"/>
            </CheckBox>
            <Grid Margin="20,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="平滑时间" Style="{StaticResource FieldLabel}"/>
                <Slider x:Name="BridgeSmoothSlider" Grid.Column="1" Minimum="0" Maximum="300"
                        SmallChange="10" LargeChange="30" TickFrequency="10" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Margin="6,0,6,0"/>
                <TextBlock x:Name="BridgeSmoothLabel" Grid.Column="2" Text="90ms" Width="52" FontSize="11"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            <CheckBox x:Name="BridgeLinkCheck" FontSize="12" Margin="0,0,0,4"
                      ToolTip="按和脚本播放相同的规则派生：快的地方加扭转、上下带左右倾。旋转中的轴不会被抢">
                <TextBlock Style="{StaticResource WrapText}"
                           Text="多轴联动：游戏只驱动一根轴时，让其它轴跟着一起动（更立体）"/>
            </CheckBox>
            <Grid Margin="20,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="联动幅度" Style="{StaticResource FieldLabel}"/>
                <Slider x:Name="BridgeLinkSlider" Grid.Column="1" Minimum="5" Maximum="60"
                        SmallChange="5" TickFrequency="5" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Margin="6,0,6,0"/>
                <TextBlock x:Name="BridgeLinkLabel" Grid.Column="2" Text="25%" Width="52" FontSize="11"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            <CheckBox x:Name="BridgeComfortCheck" FontSize="12"
                      ToolTip="「舒适档」是全局速度上限（在「设置」页选的那一档）。关掉它，游戏桥就不再受这个上限约束，动作会更快更冲 —— 确定受得了再关。默认开着。">
                <TextBlock Style="{StaticResource WrapText}" Text="也遵守「舒适档」限速（推荐）"/>
            </CheckBox>
        </StackPanel>

        <!-- ── 少见情况：延迟补偿 / 振动 / 局域网 ───────────── -->
        <Grid Margin="0,10,0,0">
            <Button x:Name="BridgeRareToggle" Content="▸ 少见情况（延迟补偿 · 振动 · 局域网）"
                    Height="28" FontSize="11" Padding="10,0" HorizontalAlignment="Left"
                    Style="{StaticResource BtnGhost}" Click="BridgeRareToggle_Click"/>
        </Grid>
        <StackPanel x:Name="BridgeRarePanel" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="延迟补偿" Style="{StaticResource FieldLabel}"/>
                <Slider x:Name="BridgeLatencySlider" Grid.Column="1" Minimum="0" Maximum="300"
                        SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        ToolTip="只作用在游戏桥上。画面里的动作先到、设备后到 → 加大；设备跑在画面前面 → 减小。0 = 不补偿。"/>
                <TextBlock x:Name="BridgeLatencyLabel" Grid.Column="2" Text="0" FontSize="11"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           MinWidth="30" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="ms" FontSize="11" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="振动响应" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BridgeVibrateModeCombo" Grid.Column="1" SelectionChanged="BridgeSetting_Changed"
                          ToolTip="这台机器没有振动附件，桥也不会向游戏宣告振动能力，所以正常游戏不会发振动指令。这里只决定「万一收到振动指令」是直接忽略还是照发（本机没有实际效果）。">
                    <ComboBoxItem Content="关闭 · 忽略振动指令（推荐）" Tag="off"/>
                    <ComboBoxItem Content="照发 V0 · 本机没有振动附件，没有实际效果" Tag="position"/>
                    <ComboBoxItem Content="映射到旋转 · 收到振动就当作旋转（往复摆动）" Tag="rotate"/>
                    <ComboBoxItem Content="映射到小幅高频抽插 · 最接近振动的手感（推荐）" Tag="stroke"/>
                </ComboBox>
            </Grid>
            <CheckBox x:Name="BridgeLanCheck" FontSize="12"
                      ToolTip="VR 头显、手机要连这台电脑时打开。打开后会弹一次 Windows 防火墙授权；关着的时候只有本机游戏连得上。">
                <TextBlock Style="{StaticResource WrapText}"
                           Text="允许局域网设备连接（VR 头显 / 手机；会弹出防火墙授权）"/>
            </CheckBox>
        </StackPanel>

        <!-- ── 指令监视 ───────────────────────────────────── -->
        <Border Height="1" Background="{StaticResource Border}" Margin="0,14,0,12"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="🔍 指令监视" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="RX = 游戏发来的原始指令，TX = Hexa 实际发给设备的动作。"
                           Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="BridgeCountText" Grid.Column="1" Text="RX 0 · TX 0"
                       FontSize="11" Foreground="{StaticResource Accent}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BridgeSelfTestBtn" Content="▶ 自测" Width="68" Height="28"
                        FontSize="11" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0"
                        ToolTip="注入一串模拟的游戏指令，验证「游戏 → 桥 → 串口 → 设备」整条链路。会真的让设备动起来，只在桥已开启时可用"
                        Click="BridgeSelfTest_Click"/>
                <Button x:Name="BridgeClearLogBtn" Content="清空" Width="60" Height="28"
                        FontSize="11" Style="{StaticResource BtnSecondary}" Click="BridgeClearLog_Click"/>
            </StackPanel>
        </Grid>
        <Grid>
            <ListBox x:Name="BridgeLogList" Height="240" Background="#0C0F12"
                     BorderBrush="{StaticResource Border}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 折行显示：指令行很长时不用横向滚动才能看到后半段。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="10"
                                       Foreground="{StaticResource Faint}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Direction}" FontFamily="Consolas"
                                       FontSize="10" FontWeight="Bold" Foreground="{Binding Brush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Consolas"
                                       FontSize="10" Foreground="{StaticResource Text}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 空状态：一片黑会让人以为坏了 -->
            <TextBlock x:Name="BridgeLogEmpty"
                       Text="还没有收到指令。桥开着、游戏连上来以后，这里会一行一行地显示。"
                       FontSize="10" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="24,0" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Text="怎么看：只看 RX 不看 TX 说明没下发（收到振动指令时 Hexa 会写明「已忽略」，用橙色标出）；TX 显示「⚠ 输出已锁定」= 设备没连接或处于急停。「▶ 自测」会真的让设备动一下。每条都记在 %LOCALAPPDATA%\Hexa\bridge-trace.log，出问题把这个文件发我。 旋转类指令（RotateCmd）会翻译成往复摆动：位置舵机做不到持续旋转，只会撞到端点后掉头。"
                   Style="{StaticResource Hint}" Foreground="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Border>
</UserControl>

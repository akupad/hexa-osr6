<Page x:Class="Hexa.Views.PlaygroundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Hexa.Controls"
      xmlns:views="clr-namespace:Hexa.Views"
      Background="{StaticResource Bg}" Title="游玩">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- 最大化时限制内容宽度并居中：否则滑块会拉成横跨整屏的长条，右侧/底部大片空白 -->
        <StackPanel Margin="24,18,24,26" MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- 标题 -->
            <TextBlock Text="🎮 游玩" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBlock Text="选好舒适档，点一个快速预设就能开始；想自己调就改下面的波形 / 强度 / 速度。"
                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>

            <!-- 为什么现在不能动 + 去哪里解决。
                 设备能跑时整条收起：不与左侧栏的连接状态重复，也不白占地方。
                 点「开始自动」/ 快速预设被挡下时会把它滚到眼前并闪一下（见 ShowBlockedHint）。 -->
            <Border x:Name="DeviceBanner" Visibility="Collapsed"
                    Background="{StaticResource WarningSoft}"
                    BorderBrush="{StaticResource Warning}" BorderThickness="1"
                    CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                <TextBlock x:Name="DeviceBannerText" Text="" FontSize="12"
                           Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
            </Border>

            <!-- ══ 开始之前：一行选档位、一行点预设（同一张卡，两行都不高）══════════
                 原来档位与预设各占卡片上下两大段（≈230px），右边空着一条；改成「标签 + 内容」两行后，
                 空出来的宽度正好放说明文字 —— 不分栏，也就没有"一栏空一截"的参差感。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="舒适档" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <WrapPanel x:Name="ComfortPanel" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="0,-8,0,0"/>
                        <!-- 说明靠右贴住卡片边缘（而不是紧跟在按钮后面留一截说不清的空白）：
                             「左边选档位、右边看这一档什么脾气」，一眼就能读完这一行。 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                                    HorizontalAlignment="Right" MaxWidth="420">
                            <TextBlock x:Name="ComfortDescription" FontSize="10"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       TextAlignment="Right"/>
                            <TextBlock x:Name="ComfortHint" Text="" FontSize="10"
                                       Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                                       TextAlignment="Right" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,12,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="快速预设" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Top" Margin="0,4,12,0"/>
                        <StackPanel Grid.Column="1" Margin="0,-2,0,0">
                            <WrapPanel x:Name="PresetPanel" HorizontalAlignment="Left"/>
                            <TextBlock Text="点一下立刻开始；高亮的就是正在用的那一套。"
                                       FontSize="10" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ 主体：左 = 自动动作 + 手柄，右 = 设备实时状态（窗口变窄自动换排法，见 code-behind）══ -->
            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="344"/>
                    <ColumnDefinition x:Name="GapCol" Width="14"/>
                    <ColumnDefinition x:Name="RightCol" Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- 左列：自动模式 + 游戏手柄 -->
                <StackPanel x:Name="LeftStack" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="自动动作" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7"/>

                        <!-- 动作 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="波形" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PatternCombo" Grid.Column="1" Height="28" FontSize="12"
                                      ToolTip="自动时做哪个动作；选「自由巡游 · 自动换动作」就让它自己换。带「自建 · 」的是你在动作页里自己做的动作"/>
                        </Grid>

                        <!-- 自建动作没进随机池时的提示（由 code-behind 按勾选状态开关）：
                             不提示的话，"我自己做的动作永远抽不到"这件事用户根本不知道 -->
                        <TextBlock x:Name="CustomPoolHint" FontSize="10" Foreground="{StaticResource Warning}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                        <!-- 现在在跑什么：左边圆点是状态灯，右边是实时节奏 -->
                        <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="8,6" Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="AutoStateDot" Width="7" Height="7" Fill="{StaticResource Muted}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="AutoBehaviorLabel" Grid.Column="1" Text="还没开始" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AutoBpmLiveLabel" Grid.Column="2" Text="" FontSize="11"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 运行中才可用的三个动作按钮：没在跑时禁用（灰掉比点了没反应清楚） -->
                        <WrapPanel Margin="0,0,0,3">
                            <Button x:Name="NextBehaviorBtn" Content="↻ 换个动作" Height="26" FontSize="11"
                                    Padding="9,0" Margin="0,0,6,5"
                                    Style="{StaticResource BtnSecondary}" Click="NextBehavior_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="立刻换成另一个动作（要先点下面的「开始自动」）"/>
                            <Button x:Name="HoldBehaviorBtn" Content="⏸ 锁住动作" Height="26" FontSize="11"
                                    Padding="9,0" Margin="0,0,6,5"
                                    Style="{StaticResource BtnSecondary}" Click="ToggleHold_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="锁住现在的动作不让它自己换，再点一次解锁（要先点下面的「开始自动」）"/>
                            <!-- 按钮名从「慢慢收尾」改成「换温和动作」：它真的只是换成温和波浪、强度降一点，
     20 秒后回到随机动作，并不会停（以前 ToolTip 写「然后慢慢停下来」是在骗人）。
     真想停请点右边的「⏹ 停止自动」或侧栏急停。 -->
                            <Button x:Name="EaseBehaviorBtn" Content="⤓ 换温和动作 20 秒" Height="26" FontSize="11"
                                    Padding="9,0" Margin="0,0,6,5"
                                    Style="{StaticResource BtnSecondary}" Click="EaseBehavior_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="换成温和波浪、强度降一点，20 秒后回到随机动作（它不会让设备停下；要停点「⏹ 停止自动」或侧栏急停）"/>
                        </WrapPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="强度" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider x:Name="IntensitySlider" Grid.Column="1" Minimum="0.1" Maximum="2.0" Value="1.0"
                                    SmallChange="0.05" ToolTip="动作幅度；当前舒适档会给它一个上限"/>
                            <TextBlock x:Name="IntensityLabel" Grid.Column="2" Text="100%" FontSize="11"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 速度 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="速度" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.1" Maximum="3.0" Value="1.0"
                                    SmallChange="0.1" ToolTip="整体快慢（和上面显示的实时节奏是同一件事）"/>
                            <TextBlock x:Name="SpeedLabel" Grid.Column="2" Text="1.0x" FontSize="11"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 点按测速（上面状态条里是"现在多少"，这里是"点出来的多少"，所以文案要点明） -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BPM" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button x:Name="TapBtn" Grid.Column="1"
                                    Content="👆 跟着点" Height="28" FontSize="11"
                                    HorizontalAlignment="Left" Padding="12,0"
                                    Style="{StaticResource BtnSecondary}"
                                    ToolTip="跟着音乐点 4 下以上，Hexa 就按你点的快慢来"
                                    Click="TapBtn_Click"/>
                            <TextBlock x:Name="BpmLabel" Grid.Column="2"
                                       Text="" FontSize="11"
                                       Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="跟着音乐点 4 下以上，Hexa 就把「速度」调成你的节拍（BPM = 每分钟节拍数）。"
                                   FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="40,4,0,12"/>

                        <Button x:Name="AutoBtn" Content="▶ 开始自动"
                                Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Stretch" Height="34"
                                ToolTip="按上面的动作 / 强度 / 速度开始（再点一次停止）"
                                Click="AutoBtn_Click"/>
                    </StackPanel>
                </Border>

                    <!-- 手柄区块：默认收起（和「自由游玩参数」「游戏桥」同一套折叠口径），
                         这一页因此能一屏到底；要用时点一下标题展开。 -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Button x:Name="GamepadFoldBtn" Content="▸ 🕹 游戏手柄"
                                    Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Height="28" FontSize="12" Padding="10,0"
                                    Click="GamepadFold_Click"/>
                            <TextBlock x:Name="GamepadFoldSummary"
                                       Text="没启用：手柄不影响设备；要用时点开"
                                       FontSize="10" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="2,6,0,0"/>
                            <StackPanel x:Name="GamepadBody" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock x:Name="GamepadStatus" Text="还没检测（插上手柄后点下面的按钮）"
                                           FontSize="11" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1"
                                           Text="左 / 右扳机 = 主行程与扭转"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1"
                                           Text="两个摇杆 = 四个副轴"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource Warning}" Margin="0,6,0,10"
                                           TextWrapping="Wrap"
                                           Text="⚠ 启用后，你动手柄设备就会跟着动。"/>
                                <Button x:Name="GamepadBtn" Content="启用手柄"
                                        Style="{StaticResource BtnSecondary}"
                                        HorizontalAlignment="Stretch" Height="32"
                                        Click="GamepadBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右列：设备实时状态（3D 会撑满这一列的高度） -->
                <Border x:Name="RightCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="设备实时状态" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LiveStateLabel" Grid.Column="1" Text="待机"
                                           FontSize="11" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- 模型就是设备真实姿态：六轴实时驱动，和动作页 / 编排页用的是同一台 SR6 逆运动学模型 -->
                            <!-- 3D 控件自己右下角已经写了鼠标操作提示，这里不再重复一行 -->
                            <TextBlock Text="下面就是设备的真实姿态，动作时会跟着动。"
                                       FontSize="10" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <views:AxisPreview3D x:Name="PlaygroundPreview" Grid.Row="1" MinHeight="260"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ 自由游玩参数（自动模式内部参数，照 ayva 的 Parameters 面板）══ -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
                <StackPanel>
                    <!-- 收起时右侧给一行当前值摘要：一眼看出现在是什么设置，不用展开 -->
                    <Button x:Name="AutoParamsToggleBtn" Style="{StaticResource BtnGhost}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="0" Height="30" Click="AutoParamsToggle_Click"
                            ToolTip="自动模式内部参数：节奏、动作时长、随机池">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutoParamsToggleText" Text="▸ 自由游玩参数"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AutoParamsSummary" Grid.Column="1" Text=""
                                       FontSize="10" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>

                    <StackPanel x:Name="AutoParamsBody" Visibility="Collapsed" Margin="0,10,0,0"
                                Grid.IsSharedSizeScope="True">
                        <TextBlock Text="改完立即生效并自动保存。BPM 按「速度 1.0x」算，拖上面的速度滑块会让它整体变快变慢。"
                                   FontSize="10" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- ── 节奏 ─────────────────────────────────────── -->
                        <TextBlock Text="节奏（BPM）" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="ParamLabel"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="86" SharedSizeGroup="ParamValue"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快慢范围" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <controls:RangeSlider x:Name="BpmRangeSlider" Grid.Column="1" SmallChange="1"
                                                  IsWheelAdjustEnabled="True"
                                                  ToolTip="拖动左右两个圆点，分别设最慢 / 最快的节奏（滚轮可微调）"/>
                            <TextBlock x:Name="BpmRangeLabel" Grid.Column="2" Text="45 – 110 BPM" FontSize="11"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="8,0,0,0"
                                       FontFamily="Consolas,Cascadia Mono,monospace"/>
                        </Grid>

                        <!-- 勾选与上面两项同一列起排，一眼看出它是这一组的开关 -->
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="ParamLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ContinuousBpmCheck" Grid.Column="1"
                                      Content="让节奏一直小幅变化（关掉 = 只在换动作时才变）"
                                      FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="ParamLabel"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="86" SharedSizeGroup="ParamValue"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="变速快慢" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="AccelerationSlider" Grid.Column="1" SmallChange="1"
                                    ToolTip="开启上面那项后，节奏每秒变多少（越大越跳）；关掉那项时这项不起作用"/>
                            <TextBlock x:Name="AccelerationLabel" Grid.Column="2" Text="8 拍/秒" FontSize="11"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- ── 动作切换 ──────────────────────────────────── -->
                        <TextBlock Text="动作切换" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="ParamLabel"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="86" SharedSizeGroup="ParamValue"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="动作时长" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <controls:RangeSlider x:Name="DurationRangeSlider" Grid.Column="1" SmallChange="1"
                                                  IsWheelAdjustEnabled="True"
                                                  ToolTip="一个动作最短 / 最长做多久（滚轮可微调）"/>
                            <TextBlock x:Name="DurationRangeLabel" Grid.Column="2" Text="8 – 24 秒" FontSize="11"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="8,0,0,0"
                                       FontFamily="Consolas,Cascadia Mono,monospace"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="ParamLabel"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="86" SharedSizeGroup="ParamValue"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="衔接时长" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="TransitionSlider" Grid.Column="1" SmallChange="0.1"
                                    ToolTip="换动作时平滑接上的时间，越长越柔和"/>
                            <TextBlock x:Name="TransitionLabel" Grid.Column="2" Text="0.9 秒" FontSize="11"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- 参与随机的动作（照 ayva：勾选哪些动作进入自动模式随机池） -->
                        <Border Background="{StaticResource Surface}" CornerRadius="6"
                                Padding="10,9" Margin="0,2,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="参与随机的动作" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PatternSelectionHint" Grid.Column="1"
                                               Text="全部参与" FontSize="10"
                                               Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="勾上的动作才会被随机抽到；这里的选项和上面的「波形」是同一份列表。带「自建 · 」的是你在动作页自己做的动作（要勾上才会进随机池），⭐ 是你收藏的动作（排在前面、也更容易被抽到）。「轻柔」档不会抽到最猛的几个动作。"
                                           FontSize="10" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,5,0,7"/>
                                <CheckBox x:Name="PatternSelectAllCheck"
                                          Content="全选 / 全不选" FontSize="12"
                                          IsThreeState="True"
                                          Click="PatternSelectAll_Click"/>
                                <UniformGrid x:Name="PatternCheckPanel" Columns="2" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ 🌉 游戏桥（可复用面板，原在测试台；收起成一行的进阶区）═════════
                 它整卡连着「指令监视」日志（240px 高的列表），摊开就是半页；而这类游戏是少数人偶尔用。
                 所以默认收成一行标题 + 当前状态摘要，点了才展开 —— 与桥自己内部「动作整形（进阶）」
                 是同一种形状。面板本身还是全宽（塞进左列 344px 的日志没法看）。 -->
            <Button x:Name="BridgeSectionBtn" Style="{StaticResource BtnGhost}" Margin="0,14,0,0"
                    Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Click="BridgeSection_Click"
                    ToolTip="给「自己会发动作指令的游戏」用的：Hexa 在本机开一个服务（游戏里通常叫 Intiface / Buttplug），游戏连上这个端口就能直接指挥设备">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BridgeSectionTitle" Text="▸ 🌉 游戏桥" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BridgeSectionSummary" Grid.Column="1" Text="" FontSize="10"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Button>
            <views:BridgePanel x:Name="BridgeSectionBody" Margin="0,8,0,0" Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>
</Page>

<Page x:Class="Hexa.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="设置">
    <Page.Resources>
        <!-- API Key 改用密码框（免得填个 key 旁边有人一眼看光）。App.xaml 里只给 TextBox
             定义了外观，而 App.xaml 是公共资产不能动，所以这里在本页内照抄同一套外观：
             同样的底色 / 描边 / 圆角 / 聚焦变绿，只把 TargetType 换成 PasswordBox。
             （PasswordBox 的模板同样靠 PART_ContentHost 承载内容，ScrollViewer 即可。） -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background"        Value="{StaticResource Surface}"/>
            <Setter Property="Foreground"        Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="7,4"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FocusVisualStyle"  Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 标题固定在最上面，卡片按窗口宽度分栏（宽=两栏、窄=一栏，见 code-behind）。 -->
        <StackPanel Margin="20,16,20,24" HorizontalAlignment="Stretch">
            <TextBlock Text="⚙️ 设置" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBlock Text="连接设备、限定每个轴能走多远，以及悬浮窗、热键和 AI 助手。"
                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>


        <!-- 宽窗口两栏、窄窗口一栏（见 code-behind ApplySettingsLayout）：设置页卡片多、
             每张都不到 520px 宽，单列限宽在 1280 窗口下左右各空 380px 而且要滚很久。
             分两栏后每栏约 570px，滑杆/按钮照样不超过 420px 的横条红线。 -->
        <Grid x:Name="SettingsColumns" MaxWidth="1160" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsLeftCol" Width="1*"/>
                <ColumnDefinition x:Name="SettingsGapCol" Width="16"/>
                <ColumnDefinition x:Name="SettingsRightCol" Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="SettingsLeftColumn" Grid.Row="0" Grid.Column="0">
                <!-- ══ 1. 连接（最常来的一张卡） ══════════════════════════════ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔌 连接" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Danger}"
                                         Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusLabel" Text="未连接" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                        </Grid>

                        <!-- 模拟设备状态条：仅当 Serial.IsSimulation=true 时显示（Visibility 由 code-behind 控制）。
                             设置页已按用户要求移除「模拟设备」开关，所以这是退出模拟的唯一入口。 -->
                        <Border x:Name="SimulationBanner" Visibility="Collapsed"
                                Background="{StaticResource WarningSoft}"
                                BorderBrush="{StaticResource Warning}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Cursor="Hand" ToolTip="退出模拟设备，回到真实串口连接"
                                MouseLeftButtonUp="ExitSimulation_Click">
                            <TextBlock Text="当前是模拟设备（未连接真实硬件）· 点这里退出模拟"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主通道" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <!-- 注意：WPF 的 ComboBox 在「闭合状态」不认 DisplayMemberPath
                                 （SelectionBoxItem 拿到的是整个对象，会显示 record 的 ToString 并撑破布局），
                                 所以这里用 ItemTemplate 同时管住下拉项和选择框。 -->
                            <ComboBox x:Name="PortCombo" Grid.Column="1" FontSize="12"
                                  MaxWidth="420" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="备用通道" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,8,10,0"/>
                            <ComboBox x:Name="FallbackPortCombo" Grid.Row="1" Grid.Column="1" FontSize="12"
                                  MaxWidth="420" HorizontalAlignment="Left"
                                      Margin="0,8,0,0" ToolTip="主通道连不上时自动改连这个口，可以留空">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="主通道连不上时会自动改连备用通道。波特率固定 115200，不用设置。"
                                   FontSize="10" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="RefreshBtn" Content="刷新设备" Width="82" Height="32"
                                    FontSize="12" Click="RefreshBtn_Click"
                                    ToolTip="重新扫描现在插着的串口（刚插上设备时点一下）"/>
                            <Button x:Name="ConnectBtn" Content="立即连接" Width="88" Height="32"
                                    FontSize="12" Style="{StaticResource BtnPrimary}"
                                    Margin="8,0,0,0" Click="ConnectBtn_Click"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoConnectCheck" Content="打开软件时自动连接设备" FontSize="12" Margin="0,0,0,7"
                          HorizontalAlignment="Left"/>
                        <CheckBox x:Name="PreferWiredCheck" Content="优先用有线，蓝牙当备用" FontSize="12"
                          HorizontalAlignment="Left"
                                  ToolTip="插着 USB 线时不用蓝牙，连得更稳"/>

                        <!-- 串口占用提示 + 一键关闭 -->
                        <Border x:Name="PortHogPanel" Visibility="Collapsed" Margin="0,12,0,0"
                                Background="{StaticResource WarningSoft}" CornerRadius="6"
                                BorderBrush="{StaticResource Warning}" BorderThickness="1" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="PortHogTitle" FontSize="11" Foreground="{StaticResource Warning}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="这些程序会独占串口，导致 Hexa 连不上设备。"
                                           FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="PortHogButtons" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 2. 轴限位（默认收起：默认值就是全程 0–9999，不需要限位的用户不该被它占一屏）════ -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Button x:Name="LimitsFoldBtn" Style="{StaticResource BtnGhost}" Padding="0" Height="30"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                ToolTip="限定每个轴能走的最大范围；六个轴都生效、所有页面共用"
                                Click="LimitsFold_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LimitsFoldTitle" Text="▸ 🎚 轴限位" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LimitsFoldSummary" Grid.Column="1" Text="" FontSize="10"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="LimitsFoldBody" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="🎚 轴限位" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="限定每个轴能走的最大范围，六个轴都生效、所有页面共用。范围收得越小，机器能到的位置越靠中间。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <!-- 安全闸：默认不勾选，拖动限位只改数值；勾选后才实时驱动设备。
                             勾选后整块变红（颜色由 code-behind 换），避免用户忘了自己开过。 -->
                        <Border x:Name="LimitDriveGatePanel" CornerRadius="6" Padding="10,9" Margin="0,0,0,10"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="LiveLimitDriveCheck" Content="拖动圆点时让设备跟着动"
                                          FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LimitDriveGateText" Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="现在关着：拖动圆点只改数字，机器不会动。想边拖边找位置，再勾上它。"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="AxisLimitGrid" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LimitDriveHintText"
                                   Text="拖好后点「保存限位」才会记住；不保存就关软件，下次还是原来的范围。"
                                   FontSize="11" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveLimitsBtn" Content="保存限位" Style="{StaticResource BtnPrimary}"
                                    Width="88" Height="32" FontSize="12" Click="SaveLimitsBtn_Click" Margin="0,0,8,0"
                                    ToolTip="把现在这六个范围记住，以后开软件也是这个范围"/>
                            <Button x:Name="ResetLimitsBtn" Content="重置为全程" Width="88" Height="32"
                                    FontSize="12" Click="ResetLimitsBtn_Click"
                                    ToolTip="六个轴都改回 0–9999（等于不限制），会立即生效并保存"/>
                            <Button Content="校准向导" Width="84" Height="32" Margin="8,0,0,0" FontSize="12"
                                    Style="{StaticResource BtnSecondary}" Click="CalibrationBtn_Click"
                                    ToolTip="跟着提示一步步测每个轴的实际边界（会让设备动起来）"/>
                            <Button Content="全部归中" Width="78" Height="32" Margin="8,0,0,0" FontSize="12"
                                    Style="{StaticResource BtnSecondary}" Click="HomeBtn_Click"
                                    ToolTip="六个轴一起回到中间位置（会让设备动起来）"/>
                        </StackPanel>
                        <TextBlock Text="「校准向导」和「全部归中」会让设备真的动起来，点之前先确认周围没人；想立刻停下，点左侧边框的「锁定急停」。"
                                   FontSize="10" Foreground="{StaticResource Faint}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ 分组：设备与排查 ════════════════════════════════════ -->
                <Grid Margin="0,18,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设备与排查" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <Border Grid.Column="1" Height="1" Background="{StaticResource Border}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 设备自检 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🔧 设备自检" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="读一下固件信息，再逐个试轴：点某个轴，机器会小幅动一下，看哪里在动就知道实际装了哪些电机（说明书上写的轴不一定都装了）。测试前会先停掉正在跑的动作。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Button x:Name="DeviceInfoBtn" Content="读取设备信息" Width="112" Height="30" FontSize="12"
                                Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Click="DeviceInfo_Click"/>
                        <TextBox x:Name="DeviceInfoBox" Margin="0,8,0,12" Height="120" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="还没读取。先连上设备，再点上面的按钮；如果串口被 MultiFunPlayer / Intiface Central 占着，会读不到。"/>
                        <TextBlock Text="逐轴测试：点一下会先动到限位范围的 15% 位置再回中，幅度不大，但机器真的会动。"
                                   FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="AxisTestPanel"/>
                        <TextBlock x:Name="AxisTestHint" Text="" FontSize="10" Foreground="{StaticResource Faint}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 固件设置（进阶）：TCodeESP32 的 #setting / $save / #restart 串口命令。
                     默认收起 —— 舵机零点这类改错会让机器反向或顶死，属于"知道自己在干什么再用"；
                     而且只有固件支持这套协议才可用（读不到列表就直说，不假装能改）。 -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Button x:Name="FirmwareFoldBtn" Style="{StaticResource BtnGhost}" Padding="0" Height="30"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                ToolTip="直接改设备固件里的设置：舵机零点、方向反转、最大角度、蓝牙、设备名…"
                                Click="FirmwareFold_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FirmwareFoldTitle" Text="▸ 🧩 固件设置（进阶）" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FirmwareFoldSummary" Grid.Column="1" Text="" FontSize="10"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <StackPanel x:Name="FirmwareFoldBody" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Text="直接改设备固件里的设置（舵机零点、方向反转、最大角度、蓝牙、设备名…）。串口协议读不到设备当前值，所以下面填的是「要改成多少」；填好点「应用改动」，再点「保存到设备」，提示要重启的项还要重启才生效。"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button x:Name="FirmwareReadBtn" Content="读取设置列表" Height="30" FontSize="12"
                                        Padding="12,0" Margin="0,0,8,8" Style="{StaticResource BtnSecondary}"
                                        ToolTip="读设备固件当前支持哪些设置项（要固件支持 #list-settings 这套命令）"
                                        Click="FirmwareRead_Click"/>
                                <Button x:Name="FirmwareApplyBtn" Content="应用改动" Height="30" FontSize="12"
                                        Padding="12,0" Margin="0,0,8,8" Style="{StaticResource BtnPrimary}"
                                        ToolTip="把填了值的项发到设备（这一步还没写进设备的 Flash，断电会丢）"
                                        Click="FirmwareApply_Click"/>
                                <Button x:Name="FirmwareSaveBtn" Content="保存到设备" Height="30" FontSize="12"
                                        Padding="12,0" Margin="0,0,8,8" Style="{StaticResource BtnSecondary}"
                                        ToolTip="让设备把设置写进自己的 Flash（$save），断电也不丢"
                                        Click="FirmwareSave_Click"/>
                                <Button x:Name="FirmwareRestartBtn" Content="重启设备" Height="30" FontSize="12"
                                        Padding="12,0" Margin="0,0,8,8" Style="{StaticResource BtnSecondary}"
                                        ToolTip="重启固件（#restart）：串口会断开几秒，之后 Hexa 会自动重连"
                                        Click="FirmwareRestart_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="FirmwareStatusText" Text="还没读取。先连上设备，再点「读取设置列表」。"
                                       FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <StackPanel x:Name="FirmwareCommonPanel"/>
                            <TextBlock x:Name="FirmwareOthersHint" Text="" FontSize="10"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,8,0,4" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="FirmwareOthersScroll" MaxHeight="280"
                                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="FirmwareOthersPanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 日志查看 -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="📄 日志查看" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LogCountText" Text="最近 0 条" FontSize="11"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <!-- 体积和上限：日志写满会自己轮转，这里说清楚上限是多少、旧内容去哪了 -->
                                <TextBlock x:Name="LogSizeText" FontSize="10"
                                           Foreground="{StaticResource Faint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="RefreshLogBtn" Content="刷新" Width="60" Height="28" FontSize="11"
                                        Click="RefreshLog_Click" ToolTip="重新读一遍日志文件"/>
                                <Button x:Name="CopyLogBtn" Content="复制全部" Width="72" Height="28" FontSize="11"
                                        Margin="6,0,0,0" Click="CopyLog_Click"
                                        ToolTip="把最近的日志复制到剪贴板，方便发给别人看"/>
                                <Button x:Name="OpenLogFileBtn" Content="打开文件" Width="72" Height="28" FontSize="11"
                                        Margin="6,0,0,0" Click="OpenLogFile_Click"
                                        ToolTip="用记事本打开完整的日志文件"/>
                                <Button x:Name="ClearLogBtn" Content="清空" Width="60" Height="28" FontSize="11"
                                        Margin="6,0,0,0" Click="ClearLog_Click"
                                        ToolTip="删掉 app.log 和上一代 app.log.1（会先问一次，删了就找不回来了）"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AutoRefreshLogCheck" Content="自动刷新（每 2 秒，排查问题时开着更方便）"
                                  FontSize="11" Margin="0,0,0,8"/>
                        <!-- 隐私开关：默认关。关着时「画面观察」的日志只写进程名（chrome (标题已隐藏)），
                             因为窗口标题会暴露用户在看什么。改动立即写进设置，下次开始观察时生效。 -->
                        <CheckBox x:Name="LogWindowTitlesCheck" Content="日志里记录窗口标题（默认关：标题会暴露你在看什么）"
                                  FontSize="11" Margin="0,0,0,8"
                                  ToolTip="关着的时候，日志只记进程名，例如「画面观察已启动：chrome (标题已隐藏)」；下次开始「画面观察」时生效"/>
                        <!-- 折行显示：日志行很长，横向滚动才能看全的后半段以前是要滚的。 -->
                        <ListBox x:Name="LogList" Height="130"
                                 Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                 BorderThickness="1" FontFamily="Consolas" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
            <StackPanel x:Name="SettingsRightColumn" Grid.Row="0" Grid.Column="2">
                <!-- ══ 3. 悬浮窗 ═══════════════════════════════════════════ -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="🪟 悬浮窗" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="桌面上的小窗，边玩边看状态；按住可以拖到任意位置。点 ✕ 只是收起来，设备照常运行（收起时会弹一次托盘提示）——想找回来，用托盘菜单里的「悬浮窗」，或点下面的按钮。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="不透明度" Width="72" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="OverlayOpacitySlider" Width="260" HorizontalAlignment="Left"
                                    Minimum="0.2" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                    VerticalAlignment="Center"
                                    ToolTip="数字越小越透明，越不挡画面"/>
                            <TextBlock x:Name="OverlayOpacityLabel" Text="100%" Width="44" FontSize="11"
                                       Foreground="{StaticResource Muted}" TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="小窗上显示哪些内容" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="OverlayShowModeCheck" Content="显示模式"
                                      FontSize="12" Margin="0,0,18,6"/>
                            <CheckBox x:Name="OverlayShowSpeedCheck" Content="显示速度"
                                      FontSize="12" Margin="0,0,18,6"/>
                            <CheckBox x:Name="OverlayShowIntensityCheck" Content="显示强度"
                                      FontSize="12" Margin="0,0,18,6"/>
                            <CheckBox x:Name="OverlayShowBpmCheck" Content="显示 BPM"
                                      FontSize="12" Margin="0,0,18,6"/>
                            <CheckBox x:Name="OverlayShowConnectionCheck" Content="显示连接状态"
                                      FontSize="12" Margin="0,0,18,6"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OverlayToggleBtn" Content="显示悬浮窗" Width="112" Height="32"
                                    FontSize="12" Style="{StaticResource BtnPrimary}" Click="OverlayToggleBtn_Click"/>
                            <TextBlock x:Name="OverlayStatusText" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ 4. 全局热键 ═════════════════════════════════════════ -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌨️ 全局热键" FontSize="14" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="恢复默认" Width="76" Height="26" FontSize="11"
                                    VerticalAlignment="Top" Click="ResetHotkeys_Click"
                                    ToolTip="七条命令的热键都改回出厂设置"/>
                        </Grid>
                        <TextBlock Text="在别的软件里也管用，不用先切回 Hexa。点「录入」→ 直接按下想用的组合键（建议带 Ctrl 或 Alt，免得打字时误触）；按 Esc 取消。「清除」= 这条命令没有热键，页面上的按钮照样能点。"
                                   FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <CheckBox x:Name="GlobalHotkeysCheck" Content="启用全局热键" FontSize="12" Margin="0,0,0,12"/>
                        <StackPanel x:Name="HotkeyBindingsPanel"/>
                        <TextBlock x:Name="HotkeyStatusText" FontSize="11" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ══ 5. AI 助手 ══════════════════════════════════════════ -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="🤖 AI 助手（API Key）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="填好这三项，「AI 助手」页就能对话并让它控制设备。三个都留空 = AI 功能关闭。这串字符只存在本机，不会上传，也不会写进代码。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API Key" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <!-- 密码框：key 是一串能花钱的凭据，别让它明文躺在屏幕上（旁边有人、或截个图就漏了）。
                                 取值走 AiKeyBox.Password（不再是 .Text），保存逻辑与字段名没变。 -->
                            <PasswordBox x:Name="AiKeyBox" Grid.Column="1" FontSize="12" Height="30" Margin="0,0,0,8"
                                         PasswordChanged="AiKey_PasswordChanged"
                                         ToolTip="从服务商网站复制过来的一长串字符，直接粘贴（Ctrl+V）。出于安全这里不显示明文，粘贴后按「保存 AI 设置」即可。"/>
                            <TextBlock Grid.Row="1" Text="接口地址" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <TextBox x:Name="AiBaseBox" Grid.Row="1" Grid.Column="1" FontSize="12" Height="30" Margin="0,0,0,8"
                                     TextChanged="AiBox_TextChanged"
                                     ToolTip="默认 https://api.deepseek.com，用别家服务时换成对应的地址"/>
                            <TextBlock Grid.Row="2" Text="模型" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="AiModelBox" Grid.Row="2" Grid.Column="1" FontSize="12" Height="30"
                                     TextChanged="AiBox_TextChanged"
                                     ToolTip="要用的模型名字，填服务商给的那个名字"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveAiBtn" Content="保存 AI 设置" Style="{StaticResource BtnPrimary}"
                                    Width="118" Height="32" FontSize="12" Click="SaveAiBtn_Click"/>
                            <TextBlock x:Name="AiDirtyHint" Text="● 改了还没保存 —— 点「保存 AI 设置」" FontSize="11"
                                       Foreground="{StaticResource Warning}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="AiStatusText" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ 分组：其它设置 ══════════════════════════════════════ -->
                <Grid Margin="0,18,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="其它设置" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <Border Grid.Column="1" Height="1" Background="{StaticResource Border}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 存储位置 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button x:Name="StorageFoldBtn" Style="{StaticResource BtnGhost}" Padding="0" Height="30"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                ToolTip="把动作合成和脚本库改到别的盘；改完只影响以后保存的文件"
                                Click="StorageFold_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StorageFoldTitle" Text="▸ 📁 存储位置" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StorageFoldSummary" Grid.Column="1" Text="" FontSize="10"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="StorageFoldBody" Visibility="Collapsed" Margin="0,10,0,0">

                        <TextBlock Text="动作合成和脚本库默认放在 C 盘的用户目录里，可以改到别的盘。改了只影响以后保存的文件，已有的文件不会自己搬过去，需要自己复制。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="动作合成目录" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompositionFolderText" Grid.Column="1" FontSize="11"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="打开" Width="48" Height="26" FontSize="11"
                                    Margin="0,0,6,0" Click="CompositionFolderOpen_Click"
                                    ToolTip="在文件管理器里打开这个目录"/>
                            <Button Grid.Column="3" Content="浏览…" Width="60" Height="26" FontSize="11"
                                    Margin="0,0,6,0" Click="CompositionFolderBrowse_Click"
                                    ToolTip="换成别的目录"/>
                            <Button Grid.Column="4" Content="恢复默认" Width="68" Height="26" FontSize="11"
                                    Click="CompositionFolderReset_Click"
                                    ToolTip="改回 C 盘用户目录"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="脚本库目录" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScriptFolderText" Grid.Column="1" FontSize="11"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="打开" Width="48" Height="26" FontSize="11"
                                    Margin="0,0,6,0" Click="ScriptFolderOpen_Click"
                                    ToolTip="在文件管理器里打开这个目录"/>
                            <Button Grid.Column="3" Content="浏览…" Width="60" Height="26" FontSize="11"
                                    Margin="0,0,6,0" Click="ScriptFolderBrowse_Click"
                                    ToolTip="换成别的目录"/>
                            <Button Grid.Column="4" Content="恢复默认" Width="68" Height="26" FontSize="11"
                                    Click="ScriptFolderReset_Click"
                                    ToolTip="改回 C 盘用户目录"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 本地控制接口：功能被强制关闭（WebApiEnabled 恒为 false），
                     这块只是"还没开放"的说明文字、白占一屏高度 ⇒ 先收起，等接口真放出来再显示。 -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 本地控制接口" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource WarningSoft}" CornerRadius="4"
                                    Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="还没开放" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource Warning}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="别的软件现在还控制不了 Hexa。这个接口能把外部程序接进来直接控制机器（写轴、急停、归中、切模式），但还缺外部调用的身份校验、操作记录和急停联动验证，补齐后再放出来；现在不会占用 8580 端口。"
                                   Foreground="{StaticResource Muted}" FontSize="11"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ══ 关于与维护（页面最下方） ══════════════════════════════ -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Button x:Name="AboutFoldBtn" Style="{StaticResource BtnGhost}" Padding="0" Height="30"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                ToolTip="版本信息、导出/导入整份设置（换电脑或重装前用）"
                                Click="AboutFold_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AboutFoldTitle" Text="▸ ℹ️ 关于与维护" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AboutFoldSummary" Grid.Column="1" Text="版本信息 · 导出/导入设置"
                                           FontSize="10" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="AboutFoldBody" Visibility="Collapsed" Margin="0,10,0,0">

                        <TextBlock Text="换电脑、重装系统之前，可以把整份设置导出来存着，需要时再导回去 —— 不用一个个页面手抄。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- 版本：只读信息，回填一次即可（运行中不会变） -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="程序版本" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="AboutVersionText" Grid.Column="1" Text="—" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行环境" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="AboutRuntimeText" Grid.Column="1" Text="—" FontSize="11"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据目录" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="AboutDataFolderText" Grid.Column="1" Text="—" FontSize="11"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="打开" Width="48" Height="26" FontSize="11"
                                    Click="AboutDataFolderOpen_Click"
                                    ToolTip="在文件管理器里打开这个目录（设置文件就在里面）"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ExportConfigBtn" Content="导出配置…" Width="104" Height="30" FontSize="12"
                                    Style="{StaticResource BtnPrimary}" Click="ExportConfig_Click"
                                    ToolTip="把当前设置打包成一个 zip 存到你想放的地方"/>
                            <Button x:Name="ImportConfigBtn" Content="导入配置…" Width="104" Height="30" FontSize="12"
                                    Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Click="ImportConfig_Click"
                                    ToolTip="选一个之前导出的 zip，覆盖现在的设置（会先备份、重启后生效）"/>
                        </StackPanel>
                        <TextBlock x:Name="AboutStatusText" FontSize="11" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="导出的包里含轴限位、热键、游戏和 AI 这些设置（里面有你的 API Key，别随便发给别人）；导入会覆盖现在的设置，导入前会自动备份一份。"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

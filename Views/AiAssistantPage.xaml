<Page x:Class="Hexa.Views.AiAssistantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="AI 助手">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- 高风险动作确认条（平时收起，不占高度） -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 顶部：状态 + 当前人格 + 常驻按钮 ══════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>

                <!-- 身份 / 设备连接 / 安全状态  +  打断朗读、清空对话 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="20" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI 助手" FontSize="15" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="{StaticResource Danger}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,2,0"/>
                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SafetyStatus}" FontSize="11"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Content="{Binding StopSpeakingButtonText}" Height="32" Width="112" Margin="0,0,8,0"
                                Command="{Binding StopSpeakingCommand}"
                                Style="{StaticResource BtnSecondary}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                ToolTip="让 AI 立刻闭嘴（打断正在播放的语音）；没在说话时按钮是灰的"
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button Content="🧹 清空对话" Height="32" Width="96"
                                Command="{Binding ClearChatCommand}"
                                Style="{StaticResource BtnSecondary}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                ToolTip="清空这里的聊天记录（会再确认一次；设备保持当前状态，不会停）"/>
                    </StackPanel>
                </Grid>

                <!-- 当前人格 + 人格管理入口（窄窗口自动换行，不挤压） -->
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="当前人格" FontSize="11" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Width="160" Margin="0,0,8,8" ItemsSource="{Binding Personas}"
                              SelectedItem="{Binding SelectedPersona, Mode=TwoWay}"
                              ToolTip="AI 用哪种性格陪你聊天，随时可换">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedPersonaKindText}" FontSize="10"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <Button Content="👤 人格管理" Height="28" Margin="0,0,0,8"
                            Command="{Binding ToggleImportCommand}"
                            Style="{StaticResource BtnSecondary}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            ToolTip="新建 / 删除人格，导入导出角色卡 JSON"/>
                </WrapPanel>

                <!-- 未配置 API：给出可点的入口，而不是只留一句话 -->
                <Border x:Name="AiConfigBanner" Background="{StaticResource WarningSoft}"
                        BorderBrush="{StaticResource Warning}"
                        BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource Warning}" VerticalAlignment="Center"
                                   Text="⚠ 还没填 API Key：现在只能看界面，不能对话、也不能让 AI 控制设备。到「设置 → AI 助手」填一个就行（Key 只存在本机）。"/>
                        <Button Grid.Column="1" x:Name="GoSettingsBannerButton" Content="去设置填 Key"
                                Height="26" MinWidth="112" Margin="10,0,0,0"
                                Style="{StaticResource BtnPrimary}" Click="GoSettings_Click"
                                ToolTip="跳到「设置 → AI 助手」，把 API Key 填进去"/>
                    </Grid>
                </Border>

                <!-- 人格管理面板（默认收起；内部可滚动，展开也不会把聊天区压没） -->
                <!-- 注意：这里不能写本地 Visibility="Collapsed"——本地值优先级高于 Style 触发器，
                     会让下面的 IsImportOpen DataTrigger 永远失效；默认收起由 Style 的 Setter 负责。 -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="10,9" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImportOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ① 换人格 -->
                            <TextBlock Text="换人格" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Text="换人格只影响 AI 说话的性格，聊天记录不会丢。上面「当前人格」里选一个即可。"/>

                            <!-- ② 新建人格 -->
                            <TextBlock Text="新建人格" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名字" FontSize="11" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" MaxWidth="220" HorizontalAlignment="Left" Height="30"
                                         FontSize="12" Text="{Binding NewPersonaName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="给这个人格起个名字，例如「温柔姐姐」"/>
                            </Grid>
                            <TextBox Height="56" FontSize="11" Margin="0,6,0,0" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding NewPersonaPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="写清楚它的性格和说话方式，例如：语气温柔，话少，喜欢用短句，会主动放慢节奏"/>
                            <Button Content="＋ 保存为新人格" Height="28" MinWidth="150" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding SaveNewPersonaCommand}"
                                    ToolTip="把上面这段设定存成一个人格，并立刻切换过去"/>

                            <!-- ③ 删除人格 -->
                            <Button Content="🗑 删除当前人格" Height="28" MinWidth="150" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Style="{StaticResource BtnSecondary}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Command="{Binding DeletePersonaCommand}"
                                    ToolTip="只能删自己新建/导入的人格；删除前会再确认一次"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <TextBlock FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Text="三个内置人格删不掉。想改内置人格的语气：点下面「导出当前人格」拿到 JSON，改完再导入成新人格。"/>

                            <!-- ④ 角色卡 JSON：导入 / 导出 -->
                            <TextBlock Text="角色卡 JSON（导入 / 导出）" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,14,0,0"/>
                            <TextBox Text="{Binding ImportJson, UpdateSourceTrigger=PropertyChanged}" Height="52"
                                     TextWrapping="Wrap" FontSize="11" AcceptsReturn="True" Margin="0,5,0,0"
                                     ToolTip="把角色卡的 JSON 粘到这里，再点「导入并应用」"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="📥 导入并应用" Height="28" MinWidth="110" Margin="0,0,8,0"
                                        Command="{Binding ImportPersonaCommand}"
                                        Style="{StaticResource BtnPrimary}"
                                        ToolTip="用这段 JSON 建一个人格并立刻切换过去"/>
                                <Button Content="📤 导出当前人格" Height="28" MinWidth="118"
                                        Command="{Binding ExportPersonaCommand}"
                                        Style="{StaticResource BtnSecondary}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        ToolTip="把当前人格变成 JSON，显示在下面，可复制或存成文件"/>
                            </StackPanel>

                            <!-- 成功提示（新建/导入成功） -->
                            <TextBlock Text="{Binding PersonaNotice}" FontSize="11"
                                       Foreground="{StaticResource Success}"
                                       TextWrapping="Wrap" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PersonaNotice}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 出错提示：与输入框分离，失败时不会把用户粘贴的 JSON 覆盖掉 -->
                            <TextBlock Text="{Binding ImportError}" FontSize="11"
                                       Foreground="{StaticResource Danger}"
                                       TextWrapping="Wrap" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImportError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 导出的 JSON：可滚动查看 / 复制 / 另存为文件 -->
                            <TextBox Text="{Binding ExportJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="110"
                                     FontSize="10" Margin="0,6,0,0"
                                     ToolTip="当前人格的 JSON；可复制或保存为文件"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="ExportCopyButton" Content="📋 复制" Height="26" Width="84"
                                        Style="{StaticResource BtnSecondary}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Margin="0,0,8,0" Click="CopyExportJson_Click"
                                        ToolTip="把上面的人格 JSON 复制到剪贴板"/>
                                <Button x:Name="ExportSaveButton" Content="💾 保存为文件" Height="26" Width="118"
                                        Style="{StaticResource BtnSecondary}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Click="SaveExportJson_Click"
                                        ToolTip="把上面的人格 JSON 保存为 .json 文件"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══ 聊天区 ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 安全提示：AI 会自己让设备动，必须一眼看得到怎么停 -->
                <Border Grid.Row="0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0" Padding="12,7">
                    <TextBlock FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="AI 会自己让设备动起来。动起来之后：按左侧「⛔ 锁定急停」立刻停，或者直接对它说「停」。"/>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Messages}" Margin="14,12,14,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <!-- 系统提示（AI 的设备动作 / 出错）：居中细条，不带头像 -->
                                            <Border x:Name="Notice">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <!-- MaxWidth 放在 Setter 里而不是本地属性上：
                                                             本地值的优先级高于 DataTemplate 触发器，写成本地值会让出错那条的加宽失效。 -->
                                                        <Setter Property="MaxWidth" Value="520"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="CornerRadius" Value="9"/>
                                                        <Setter Property="Padding" Value="10,5"/>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock x:Name="NoticeText" Text="{Binding Text}"
                                                           FontSize="10" TextWrapping="Wrap" TextAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- 正常消息：用户靠右、AI 靠左带头像 -->
                                            <Grid x:Name="MsgRow">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="Avatar" Grid.Column="0" Width="28" Height="28"
                                                        CornerRadius="14" Background="{StaticResource PrimaryGradient}"
                                                        Margin="0,0,8,0" VerticalAlignment="Top">
                                                    <TextBlock Text="AI" FontSize="10" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel x:Name="Body" Grid.Column="1">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <StackPanel Orientation="Horizontal" Margin="2,0,2,3">
                                                        <TextBlock Text="{Binding Sender}" FontSize="10"
                                                                   Foreground="{StaticResource Muted}"/>
                                                        <TextBlock Text=" · " FontSize="10"
                                                                   Foreground="{StaticResource Faint}"/>
                                                        <TextBlock Text="{Binding Time}" FontSize="10"
                                                                   Foreground="{StaticResource Faint}"/>
                                                        <!-- 流式：正在逐字接收 / 半截被中断。都标出来，
                                                             免得"还没说完"看起来像"就说这么多"。 -->
                                                        <TextBlock Text=" · 正在输入…" FontSize="10"
                                                                   Foreground="{StaticResource Primary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"
                                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text=" · 已中断（可能没说完）" FontSize="10"
                                                                   Foreground="{StaticResource Danger}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"
                                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Interrupted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border x:Name="Bubble" CornerRadius="10" Padding="12,8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="MaxWidth" Value="520"/>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock x:Name="BubbleText" Text="{Binding Text}"
                                                                   TextWrapping="Wrap" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"
                                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNotice}" Value="True">
                                                <Setter TargetName="Notice" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="MsgRow" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="Notice" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="MsgRow" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Notice" Property="Background" Value="{StaticResource DangerSoft}"/>
                                                <Setter TargetName="Notice" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                                <Setter TargetName="Notice" Property="MaxWidth" Value="560"/>
                                                <Setter TargetName="NoticeText" Property="Foreground" Value="{StaticResource Text}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Body" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource Primary}"/>
                                                <Setter TargetName="Bubble" Property="BorderThickness" Value="0"/>
                                                <Setter TargetName="Bubble" Property="MaxWidth" Value="460"/>
                                                <Setter TargetName="BubbleText" Property="Foreground" Value="{StaticResource OnPrimaryInk}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 等待 AI 回复：三点跳动 + 文字，替代原来那条"……（正在思考）"假消息。
                                 流式下收到第一个字就收起（IsThinking），文字已经在气泡里长出来了。 -->
                            <StackPanel x:Name="ThinkingRow" Orientation="Horizontal" Margin="14,0,14,14">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{StaticResource PrimaryGradient}" Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="AI" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{StaticResource Primary}"
                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{StaticResource Primary}"
                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource Primary}"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="正在思考…（要中止就点下面「取消」）" FontSize="11"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 空状态：没 API Key 指路，配好了给几句起手话 -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="440" Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Messages.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="🤖" FontSize="26" HorizontalAlignment="Center"/>

                        <!-- 没配 API Key -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiConfigured}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="先填一个 API Key 就能开始" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="到「设置 → AI 助手」填 Key（DeepSeek 或硅基流动都行），回来这里就能对话、也能让 AI 控制设备。Key 只存在本机。"/>
                            <Button Content="去设置填 Key" Height="30" MinWidth="140" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Style="{StaticResource BtnPrimary}"
                                    Click="GoSettings_Click"/>
                        </StackPanel>

                        <!-- 配好了：给几句可以直接发的话 -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiConfigured}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="想让设备怎么动，直接说就行" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="它会自己挑场景、调速度、改节奏；说得越具体，动作越合你意。下面是几句可以直接点来试的："/>
                            <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="现在设备是什么状态？" Height="26" FontSize="11" Margin="0,0,6,6"
                                        Padding="10,0" Click="Suggestion_Click"
                                        Style="{StaticResource BtnSecondary}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                                <Button Content="慢一点，温柔些" Height="26" FontSize="11" Margin="0,0,6,6"
                                        Padding="10,0" Click="Suggestion_Click"
                                        Style="{StaticResource BtnSecondary}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                                <Button Content="换个节奏玩玩" Height="26" FontSize="11" Margin="0,0,6,6"
                                        Padding="10,0" Click="Suggestion_Click"
                                        Style="{StaticResource BtnSecondary}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                                <!-- 「停一下」必须**真的停**：以前它和别的起手话一样只把文字填进输入框，
                                     而同页顶部还写着"要停按急停或直接说停" —— 用户按了"停一下"以为停了，
                                     设备其实还在动。停设备这件事不该需要"再点一次发送"。 -->
                                <Button Content="⏹ 停一下（立刻停设备）" Height="26" FontSize="11" Margin="0,0,6,6"
                                        Padding="10,0" Click="StopMotion_Click"
                                        Style="{StaticResource BtnDanger}"
                                        ToolTip="立刻停住设备（不是发消息）"/>
                            </WrapPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,2,0,0"
                                       Text="点一下会把这句话填进下面的输入框，确认后按「发送」；「⏹ 停一下」是直接停住设备，不用再点发送。"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 用户往上翻看历史时，新消息不再强行把视图拽到底 -->
                    <Button x:Name="JumpLatestButton" Content="↓ 最新消息" Height="26" Padding="10,0"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12"
                            Style="{StaticResource BtnSecondary}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Visibility="Collapsed" Click="JumpLatest_Click"
                            ToolTip="回到最新一条消息"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ 高风险动作确认：非模态 3 秒倒计时 ══════════════════════════
             为什么不做模态弹窗：AI 运动是连续的，弹框会占住用户的双手和注意力；
             这里做成一条横幅：3 秒后自动开始，点「✋ 不要」立刻取消（AI 会知道被你拒了）。
             关掉「设置 → AI 助手」里的确认开关后，这条横幅根本不会出现。 -->
        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="8" Padding="12,9"
                Background="{StaticResource WarningSoft}"
                BorderBrush="{StaticResource Warning}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfirmVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text}"
                                   Text="{Binding ConfirmActionText, StringFormat=即将执行：{0}}"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" Text="{Binding ConfirmReasonText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="{Binding ConfirmCountdownText}" FontSize="11"
                                   Foreground="{StaticResource Warning}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button Content="✅ 现在执行" Height="28" MinWidth="96" Margin="0,0,8,0"
                                Style="{StaticResource BtnPrimary}"
                                Command="{Binding ConfirmApproveCommand}"
                                ToolTip="不用等这 3 秒，立刻就开始"/>
                        <Button Content="✋ 不要" Height="28" MinWidth="80"
                                Style="{StaticResource BtnDanger}"
                                Command="{Binding ConfirmRejectCommand}"
                                ToolTip="取消这个动作：AI 会知道你拒绝了，会换一个更温和的做法"/>
                    </StackPanel>
                </Grid>

                <!-- 倒计时进度：Maximum 要和 ViewModel 里的 ConfirmSeconds(3) 一致 -->
                <ProgressBar Grid.Row="1" Height="4" Margin="0,8,0,0"
                             Minimum="0" Maximum="3"
                             Foreground="{StaticResource Warning}"
                             Value="{Binding ConfirmRemaining, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- ══ 底部输入 ═════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- 不给 MinWidth：窄窗口下让输入框自己变窄，别把右边按钮挤到容器外面去 -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="InputBox" MinHeight="34" MaxHeight="92" FontSize="13"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="说点什么…（Enter 发送，Shift+Enter 换行）" FontSize="12"
                                   Foreground="{StaticResource Faint}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="1" Content="{Binding ListenButtonText}" Height="34" Width="104"
                            Margin="8,0,0,0" Style="{StaticResource BtnSecondary}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Command="{Binding ToggleListeningCommand}"
                            ToolTip="语音输入（中文）：点一下开始说，识别到一句就自动发送；再点一下停止。不能用时按钮是灰的"
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button Grid.Column="2" Content="取消" Width="56" Height="34" Margin="8,0,0,0"
                            Style="{StaticResource BtnSecondary}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Command="{Binding CancelRequestCommand}"
                            ToolTip="不再等这次 AI 回复（正在说的话也会被打断）"
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button Grid.Column="3" Content="{Binding SendButtonText}" Width="84" Height="34" Margin="8,0,0,0"
                            Command="{Binding SendCommand}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiConfigured}" Value="False">
                                        <Setter Property="ToolTip" Value="还没填 API Key：点上方的「去设置填 Key」填好就能发"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAiConfigured}" Value="True">
                                        <Setter Property="ToolTip" Value="发送给 AI（Enter 也一样）"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding SpeechStatus}" FontSize="10"
                           Foreground="{StaticResource Muted}" Margin="2,6,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Page>

<Page x:Class="Hexa.Views.StrokesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:Hexa.Views"
      Background="{StaticResource Bg}" Title="动作">
    <!-- 版面说明（660px 正文宽也不许切内容）：
         页头 / 工具条 / 设备提示都是 Auto 行，卡片墙和右栏吃剩下的高度。
         工具条里的分类、搜索、速度、播放全部用 WrapPanel 排 —— 宽度不够时换行，不会被裁掉。
         右栏宽度和卡片宽度由 code-behind 按窗口实算（SideColumn / _cardWidth），不写死像素。 -->
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0 页头 -->
            <RowDefinition Height="Auto"/>  <!-- 1 工具条：分类 / 搜索 / 速度 / 播放 -->
            <RowDefinition Height="Auto"/>  <!-- 2 设备状态提示（没连上 / 急停时才出现） -->
            <RowDefinition Height="*"/>     <!-- 3 主体：动作卡片墙 + 预览 / 详情 -->
        </Grid.RowDefinitions>

        <!-- ══ 0 页头 ══════════════════════════════════════════════════
             两行：标题 + 说明在上，动作按钮在下。
             为什么分行：按钮从一个变三个再变五个，挤在标题右边时窄窗口（正文约 660px）
             会把标题列压到最小宽度以下、按钮被窗口边缘切掉 —— 换成两行后 WrapPanel
             自己换行，任何宽度下都完整可见。 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="🎯 动作" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="点卡片＝选中，再点「▶ 播放」让设备做这个动作；鼠标停在卡片上可以在右边先看效果，不会让设备动。"
                           FontSize="12" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="NewStrokeBtn" Content="＋ 新建动作" Style="{StaticResource BtnPrimary}"
                        Height="32" Padding="12,0" Click="NewStroke_Click"
                        ToolTip="自己拼一个动作：六个轴各设范围、错开和运动方式，保存后出现在卡片墙里"/>
                <Button x:Name="EditStrokeBtn" Content="✏ 编辑选中" Style="{StaticResource BtnSecondary}"
                        Height="32" Padding="12,0" Margin="8,0,0,0" IsEnabled="False" Click="EditStroke_Click"
                        ToolTip="改选中的那个动作；内置动作改完会存成一份新的自建动作，原动作不动"/>
                <Button x:Name="DeleteStrokeBtn" Content="🗑 删除选中" Style="{StaticResource BtnDanger}"
                        Height="32" Padding="12,0" Margin="8,0,0,0" IsEnabled="False"
                        ToolTip="只能删除自己新建的动作；内置动作删不掉（删了下次启动还会回来）"
                        Click="DeleteStroke_Click"/>
                <!-- 导入 / 导出以前只挂在脚本库页，用户找不到；这里补上同一条通道（同一套服务实现） -->
                <Button x:Name="ImportPresetsBtn" Content="⬇ 导入动作" Style="{StaticResource BtnSecondary}"
                        Height="32" Padding="12,0" Margin="8,0,0,0" Click="ImportPresets_Click"
                        ToolTip="从 JSON 文件导入动作（和脚本库页的「导入动作库」是同一套：同名会自动改名，不会覆盖你已有的动作）"/>
                <Button x:Name="ExportPresetsBtn" Content="⬆ 导出动作" Style="{StaticResource BtnSecondary}"
                        Height="32" Padding="12,0" Margin="8,0,0,0" Click="ExportPresets_Click"
                        ToolTip="把动作库里的全部动作存成一个 JSON 文件，可以备份或分享给别人"/>
            </WrapPanel>
        </Grid>

        <!-- ══ 1 工具条 ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <!-- 分类筛选（含「只看自建 / ⭐ 只看收藏 / 🕘 最近用过 / 幅度排序」四个开关，由 code-behind 生成） -->
                <WrapPanel x:Name="CategoryTabs" Orientation="Horizontal" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左半：搜索 + 结果条数 -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="176" Height="28" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" FontSize="12" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                                     ToolTip="按动作名、类别或标识筛选，输入几个字即时筛出来；按 Esc 清空"/>
                            <!-- TextBox 没有占位符，这里盖一层提示字：有内容时由 code-behind 收起 -->
                            <TextBlock x:Name="SearchHint" Text="🔍 搜索动作名 / 类别" FontSize="12"
                                       Foreground="{StaticResource Faint}"
                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="ClearSearchBtn" Content="✕ 清空" Style="{StaticResource BtnSecondary}"
                                Height="28" Padding="8,0" FontSize="11" VerticalAlignment="Center"
                                Margin="0,0,10,0" Visibility="Collapsed" Click="ClearSearch_Click"
                                ToolTip="只清掉搜索词（分类筛选保持不动）；按 Esc 也是这个效果"/>
                        <TextBlock x:Name="CountLabel" FontSize="11" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Text=""/>
                    </WrapPanel>

                    <!-- 右半：速度 + 播放（整组一起换行，不会被拆散） -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                               Margin="10,0,0,0">
                        <TextBlock Text="速度" FontSize="11" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SpeedSlider" Width="104" Minimum="0.1" Maximum="3.0" Value="1.0"
                                SmallChange="0.1" VerticalAlignment="Center"
                                ToolTip="动作快慢（0.1x–3.0x）：播放设备时按这个倍率跑；右侧试看固定每秒 1 圈，只作演示"/>
                        <TextBlock x:Name="SpeedLabel" Text="1.0x" FontSize="11"
                                   Foreground="{StaticResource Muted}" Width="34"
                                   VerticalAlignment="Center" Margin="6,0,10,0"/>
                        <Button x:Name="PlayBtn" Content="▶ 播放" Style="{StaticResource BtnPrimary}"
                                MinWidth="84" Height="30" Click="PlayBtn_Click"
                                ToolTip="用当前选中的动作驱动设备；再点一下就是停止"/>
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ 2 设备状态提示：只有「不能播放」的时候才出现，平时不占地方 ══ -->
        <Border x:Name="DeviceHintBar" Grid.Row="2" Background="{StaticResource WarningSoft}"
                CornerRadius="6" Padding="10,7" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="DeviceHintText" FontSize="11" Foreground="{StaticResource Warning}"
                       TextWrapping="Wrap" Text=""/>
        </Border>

        <!-- ══ 3 主体：左＝动作卡片墙，右＝3D 预览 + 选中动作详情 ═════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="SideColumn" Width="264"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="CardScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- 右边留 6px：竖向滚动条出现时不至于贴着卡片（滚动条本身 8px 由 code-behind 预留） -->
                <WrapPanel x:Name="CardPanel" Margin="0,0,6,8"/>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- 预览与详情按比例分配高度；上下限都放低，窗口压到最小时也不会把详情挤出屏幕 -->
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>   <!-- 试看状态 + 试看按钮 -->
                    <RowDefinition Height="2*" MinHeight="110"/>
                </Grid.RowDefinitions>

                <views:AxisPreview3D x:Name="Preview3D" Grid.Row="0"/>

                <!-- 试看状态行：悬停试看 / 点按钮试看 / 实时输出，用户随时知道右边看的是什么 -->
                <Grid Grid.Row="1" Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewCaption" Text="实时输出（跟设备同步）" FontSize="10"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="PreviewToggleBtn" Grid.Column="1" Content="👁 试看选中"
                            Style="{StaticResource BtnSecondary}" Height="26" Padding="8,0" FontSize="11"
                            Margin="6,0,0,0" IsEnabled="False" Click="PreviewToggle_Click"
                            ToolTip="不用一直悬停：点一下就在这里循环演示选中的动作（只动预览，不会让设备动）"/>
                </Grid>

                <!-- 选中动作详情（内容由 code-behind 生成） -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel">
                            <TextBlock Text="还没选动作" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="在左边的卡片上点一下，这里会显示它六个轴各自怎么动。"
                                       FontSize="11" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

<Window x:Class="Hexa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hexa" Height="760" Width="1180"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ──────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{StaticResource BgRaised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="32" Height="32" CornerRadius="9"
                            Background="{StaticResource PrimaryGradient}"
                            VerticalAlignment="Center">
                        <TextBlock Text="H" FontSize="16" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HEXA" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock Text="MOTION CONSOLE" FontSize="8.5"
                                   Foreground="{StaticResource Primary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav items -->
                <StackPanel Grid.Row="1" Margin="10,10,10,0">
                    <Button x:Name="NavPlayground" Content="🎮  游玩"
                            Style="{StaticResource BtnBase}"
                            Background="{StaticResource Primary}"
                            Foreground="{StaticResource OnPrimaryInk}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,3"
                            Click="Nav_Click" Tag="playground"/>
                    <Button x:Name="NavManual" Content="🕹  手动动轴"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,3"
                            Click="Nav_Click" Tag="manual"/>
                    <Button x:Name="NavStrokes" Content="🎯  动作"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,3"
                            Click="Nav_Click" Tag="strokes"/>
                    <Button x:Name="NavEditor" Content="✍  脚本制作"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,3"
                            Click="Nav_Click" Tag="editor"/>
                    <Button x:Name="NavAi" Content="🤖  AI 助手"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,3"
                            Click="Nav_Click" Tag="ai"/>
                    <Button x:Name="NavScripts" Content="📚  脚本库"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9"
                            Click="Nav_Click" Tag="scripts"/>
                    <Button x:Name="NavSettings" Content="⚙️  设置"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,3"
                            Click="Nav_Click" Tag="settings"/>
                    <Button x:Name="NavTestLab" Content="🧪  测试台"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9"
                            Click="Nav_Click" Tag="testlab"/>
                </StackPanel>

                <!-- Connection and safety controls stay visible on every page. -->
                <StackPanel Grid.Row="2" Margin="10,0,10,12">
                    <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="11,9"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnDot" Width="8" Height="8"
                                         Fill="{StaticResource Danger}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="ConnLabel" Text="未连接"
                                           FontSize="11" Foreground="{StaticResource Text}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="SafetyLabel" Text="未连接" FontSize="10"
                                       Foreground="{StaticResource Muted}" Margin="15,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- 一行说清「为什么不动」：谁在驱动 / 输出锁没锁 / 游戏最近发了什么 -->
                            <TextBlock x:Name="WhyLabel" Text="" FontSize="10"
                                       Foreground="{StaticResource Muted}" Margin="15,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="HomeBtn" Content="⬆  全部归中" Height="32" Margin="0,0,0,6"
                            Style="{StaticResource BtnSecondary}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            ToolTip="设备处于急停时会解除急停并重新使能输出"
                            Click="HomeBtn_Click"/>
                    <Button x:Name="EStopBtn" Content="⛔  锁定急停" Height="32"
                            Style="{StaticResource BtnDanger}" Click="EStopBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content frame ────────────────────────────────────── -->
        <Frame x:Name="ContentFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource Bg}"/>
    </Grid>
</Window>
